{
  "name": "@e2e-dev/agentmail",
  "version": "0.0.0",
  "description": "AgentMail inboxes for e2e: real email addresses behind config.email",
  "keywords": [
    "e2e",
    "testing",
    "agentic",
    "end-to-end",
    "email",
    "inbox",
    "agentmail",
    "otp",
    "magic-link"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/agentmail"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/agentmail#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "agentmail": "0.5.31"
  },
  "peerDependencies": {
    "e2e": ">=0.15.0 <1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
